{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [

        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Default config",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "inherits": "cpp20",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_INSTALL_PREFIX" : "${sourceDir}/build/default/install/",
                "CMAKE_BUILD_TYPE": "Release",
                "USE_OMP": "ON",
                "USE_RAJA": "OFF",
                "USE_KOKKOS": "OFF",
                "ENABLE_TESTS": "ON"
            },
            "vendor": {
                "example.com/ExampleIDE/1.0": {
                    "autoFormat": true
                }
            }
        },
        {
            "name": "kokkos",
            "displayName": "kokkos Config",
            "description": "kokkos config",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "inherits": "cpp20",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_INSTALL_PREFIX" : "${sourceDir}/build/${presetName}/install/",
                "CMAKE_BUILD_TYPE": "Release",
                "USE_OMP": "OFF",
                "USE_RAJA": "OFF",
                "USE_KOKKOS": "ON",
                "ENABLE_TESTS": "ON"
            },
            "vendor": {
                "example.com/ExampleIDE/1.0": {
                    "autoFormat": true
                }
            }
        },
        {
            "name": "raja",
            "displayName": "raja Config",
            "description": "raja config",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "inherits": "cpp20",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_INSTALL_PREFIX" : "${sourceDir}/build/${presetName}/install/",
                "CMAKE_BUILD_TYPE": "Release",
                "USE_OMP": "OFF",
                "USE_RAJA": "ON",
                "USE_KOKKOS": "OFF",
                "ENABLE_TESTS": "ON"
            },
            "vendor": {
                "example.com/ExampleIDE/1.0": {
                    "autoFormat": true
                }
            }
        },
        {
            "name": "cpp20",
            "displayName": "C++ Standard",
            "description": "C++ Standard",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20"
            }
        },
        {
            "name": "cpp23",
            "displayName": "C++ Standard",
            "description": "C++ Standard",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23"
            }
        },
        {
            "name": "cpp17",
            "displayName": "C++ Standard",
            "description": "C++ Standard",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17"
            }
        },
        {
            "name": "rocm",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "amdclang++",
                "CMAKE_C_COMPILER": "amdclang",
                "DEVICE": "rocm"
            }
        },
        {
            "name": "kokkos+rocm",
            "inherits": ["rocm", "kokkos"],
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "jobs": 10
        },
        {
            "name": "kokkos",
            "configurePreset": "kokkos",
            "jobs": 10
        },
        {
            "name": "raja",
            "configurePreset": "raja",
            "jobs": 10
        },
        {
            "name": "kokkos+rocm",
            "configurePreset": "kokkos+rocm"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",

            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "ignore",
                "stopOnFailure": true
            },
            "environment": {
                "OMP_PROC_BIND": "true"
            }
        },
        {
            "name": "kokkos",
            "inherits": "default",
            "configurePreset": "kokkos"
        },
        {
            "name": "raja",
            "inherits": "default",
            "configurePreset": "raja"
        },
        {
            "name": "kokkos+rocm",
            "inherits": ["kokkos"],
            "configurePreset": "kokkos+rocm"
        }   
    ],
    "vendor": {
        "example.com/ExampleIDE/1.0": {
            "autoFormat": false
        }
    }
}